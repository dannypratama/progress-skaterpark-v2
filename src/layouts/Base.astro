---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { base } from "../lib/urls.js";

const {
  title = "Progress Skaterpark Tegal // Public Concrete Skatepark & Skate School",
  description = "Public concrete skatepark and private skate school at Jl. Pancasila 66, Mangkukusuman, Tegal. Open 08.00-22.00 daily, entry Rp 50.000 per person per day.",
  current = "home",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={base("/assets/images/logo/skatepark-logo.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Stencil+Display:wght@800;900&family=Darker+Grotesque:wght@500;700&family=JetBrains+Mono:wght@500;700&family=Unbounded:wght@700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Self-contained SVG Surface Grain Overlay -->
    <svg class="grain-overlay" aria-hidden="true">
      <filter id="concrete-grain">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.82"
          numOctaves="3"
          stitchTiles="stitch"
        />
      </filter>
      <rect width="100%" height="100%" filter="url(#concrete-grain)" />
    </svg>

    <!-- Custom Spotlight Cursor Orb -->
    <div id="cursor-orb" class="cursor-orb" aria-hidden="true">DROP IN</div>

    <SiteHeader current={current} />

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter />

    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrollTrigger.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/SplitText.min.js"></script>
    <script is:inline>
      (function () {
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const isDesktop = window.innerWidth >= 768;

        // 1. Mobile Navigation Toggle + Escape Key
        const menuBtn = document.getElementById("menu-btn");
        const navList = document.getElementById("hud-nav-list");
        if (menuBtn && navList) {
          menuBtn.addEventListener("click", () => {
            const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
            menuBtn.setAttribute("aria-expanded", String(!isOpen));
            navList.setAttribute("data-open", String(!isOpen));
          });
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && menuBtn.getAttribute("aria-expanded") === "true") {
              menuBtn.setAttribute("aria-expanded", "false");
              navList.setAttribute("data-open", "false");
              menuBtn.focus();
            }
          });
          navList.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
              menuBtn.setAttribute("aria-expanded", "false");
              navList.setAttribute("data-open", "false");
            });
          });
        }

        // 2. Pausable Announcement Ticker
        const tickerTrack = document.getElementById("top-ticker-track");
        const pauseBtn = document.getElementById("ticker-pause-btn");
        if (tickerTrack && pauseBtn) {
          pauseBtn.addEventListener("click", () => {
            const paused = tickerTrack.getAttribute("data-paused") === "true";
            tickerTrack.setAttribute("data-paused", String(!paused));
            pauseBtn.setAttribute("aria-pressed", String(!paused));
            pauseBtn.textContent = !paused ? "Play" : "Pause";
          });
        }

        // 3. Cursor-Tracking Googly Skate-Eyes (The Whoopsies mechanic)
        const pupils = document.querySelectorAll(".eye-pupil");
        if (!reduced && pupils.length) {
          window.addEventListener("pointermove", (e) => {
            pupils.forEach((p) => {
              const rect = p.parentElement.getBoundingClientRect();
              const cx = rect.left + rect.width / 2;
              const cy = rect.top + rect.height / 2;
              const angle = Math.atan2(e.clientY - cy, e.clientX - cx);
              const dist = Math.min(5, Math.hypot(e.clientX - cx, e.clientY - cy) / 22);
              const tx = Math.cos(angle) * dist;
              const ty = Math.sin(angle) * dist;
              p.style.transform = "translate(" + tx + "px, " + ty + "px)";
            });
          });
        }

        // 4. Custom Cursor Spotlight Orb (Guillaume Colombel mechanic)
        const orb = document.getElementById("cursor-orb");
        if (!reduced && isDesktop && orb && window.gsap) {
          const xTo = gsap.quickTo(orb, "left", { duration: 0.2, ease: "power3" });
          const yTo = gsap.quickTo(orb, "top", { duration: 0.2, ease: "power3" });
          window.addEventListener("pointermove", (e) => {
            orb.classList.add("is-active");
            xTo(e.clientX);
            yTo(e.clientY);
          });
          document.querySelectorAll("[data-cursor-label]").forEach((sec) => {
            sec.addEventListener("pointerenter", () => {
              orb.textContent = sec.getAttribute("data-cursor-label");
            });
          });
        }
      })();
    </script>
  </body>
</html>
